<Window x:Class="MailStudio.MainWindow" Icon="pack://application:,,,/MailStudio;component/Resources/MailStudio.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:m="clr-namespace:MailStudio.Models;assembly=MailStudio.Core"
        xmlns:local="clr-namespace:MailStudio"
        Title="Gelen Kutusu - MailStudio for TRMachinist" Height="860" Width="1500" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen" FontSize="12.5" Background="{DynamicResource BgAppCanvasBrush}">
    <Window.Resources>
        <CollectionViewSource x:Key="MailView"/>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
        <Style x:Key="FilterTab" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,16,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="b" BorderThickness="0,0,0,2" BorderBrush="Transparent" Padding="1,3,1,4">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/></Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentPrimaryBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NavIcon" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- sekmeler -->
            <RowDefinition Height="Auto"/>   <!-- ribbon -->
            <RowDefinition Height="*"/>      <!-- content -->
            <RowDefinition Height="Auto"/>   <!-- undo send bar -->
            <RowDefinition Height="Auto"/>   <!-- status bar -->
        </Grid.RowDefinitions>

        <!-- ================= TAB STRIP (36 px) ================= -->
        <DockPanel Background="{DynamicResource AccentHeaderBrush}" MinHeight="36">
            <Button DockPanel.Dock="Left" Click="OnFileMenu" Cursor="Hand" Foreground="{DynamicResource TextOnAccentBrush}" Background="{DynamicResource AccentHeaderDarkBrush}"
                    BorderThickness="0" Padding="16,0" MinHeight="0" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Stretch" Content="Dosya">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center"/></Border>
                        <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource AccentHeaderHoverBrush}"/></Trigger></ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Border DockPanel.Dock="Right" Margin="0,0,8,0" VerticalAlignment="Center" Background="#33FFFFFF" CornerRadius="3" Height="26" Width="260" ToolTip="Yapay zekaya sor (Enter) — cevap sağdaki AI panelinde açılır">
                <Grid>
                    <TextBlock Foreground="{DynamicResource AccentHeaderTextBrush}" Opacity="0.85" Text="&#xE721;" FontFamily="{StaticResource Icons}" FontSize="13" VerticalAlignment="Center" Margin="9,0,0,0"/>
                    <TextBox x:Name="TellMeBox" Padding="28,0,6,0" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource AccentHeaderTextBrush}" CaretBrush="{DynamicResource AccentHeaderTextBrush}"
                             MinHeight="0" VerticalContentAlignment="Center" KeyDown="OnTellMe" FontSize="12.5">
                        <TextBox.Template>
                            <ControlTemplate TargetType="TextBox"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" Focusable="False"/></ControlTemplate>
                        </TextBox.Template>
                    </TextBox>
                    <TextBlock x:Name="TellMePlaceholder" Text="Yapay zekaya sor…" Foreground="{DynamicResource AccentHeaderTextBrush}" Opacity="0.75" FontSize="12.5" Margin="30,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                </Grid>
            </Border>
            <StackPanel Orientation="Horizontal" Margin="2,0,0,0">
                <RadioButton x:Name="TabHome" GroupName="rib" Content="Giriş" Style="{StaticResource RibbonTab}" Tag="home" IsChecked="True" Checked="OnRibbonTabChanged" Click="OnRibbonTabClick"/>
                <RadioButton GroupName="rib" Content="Gönder / Al" Style="{StaticResource RibbonTab}" Tag="sendrecv" Checked="OnRibbonTabChanged" Click="OnRibbonTabClick"/>
                <RadioButton GroupName="rib" Content="Klasör" Style="{StaticResource RibbonTab}" Tag="folder" Checked="OnRibbonTabChanged" Click="OnRibbonTabClick"/>
                <RadioButton GroupName="rib" Content="Görünüm" Style="{StaticResource RibbonTab}" Tag="view" Checked="OnRibbonTabChanged" Click="OnRibbonTabClick"/>
                <RadioButton GroupName="rib" Content="Yapay Zeka" Style="{StaticResource RibbonTab}" Tag="ai" Checked="OnRibbonTabChanged" Click="OnRibbonTabClick"/>
            </StackPanel>
        </DockPanel>

        <!-- ================= COMPACT RIBBON ================= -->
        <Border Grid.Row="1" Background="{DynamicResource BgSurfaceSecondaryBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1" MinHeight="58" Padding="4,2">
            <Grid x:Name="RibbonGrid">
                <!-- HOME -->
                <WrapPanel x:Name="RibbonHome" Orientation="Horizontal">
                    <HeaderedContentControl Header="Yeni" Style="{StaticResource RibbonGroup}">
                        <Button Style="{StaticResource RibbonPrimaryCmd}" Tag="&#xE715;" Click="OnNewMail" Content="Yeni E-posta" ToolTip="Yeni e-posta (Ctrl+N)"/>
                    </HeaderedContentControl>
                    <HeaderedContentControl Header="Sil" Style="{StaticResource RibbonGroup}">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource RibbonCmd}" Tag="&#xE74D;" Click="OnDelete" x:Name="BtnDelete" Content="Sil" ToolTip="Silinmiş Öğeler'e taşı (Delete)"/>
                            <Button Style="{StaticResource RibbonCmd}" Tag="&#xE7B8;" Click="OnArchive" x:Name="BtnArchive" Content="Arşivle"/>
                        </StackPanel>
                    </HeaderedContentControl>
                    <HeaderedContentControl Header="Yanıtla" Style="{StaticResource RibbonGroup}">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource RibbonCmd}" Tag="&#xE97A;" Click="OnReply" Content="Yanıtla" ToolTip="Yanıtla (Ctrl+R)"/>
                            <Button Style="{StaticResource RibbonCmd}" Tag="&#xE8C2;" Click="OnReplyAll" Content="Tümünü Yanıtla" ToolTip="Tümünü yanıtla (Ctrl+Shift+R)"/>
                            <Button Style="{StaticResource RibbonCmd}" Tag="&#xE72D;" Click="OnForward" Content="İlet" ToolTip="İlet (Ctrl+F)"/>
                        </StackPanel>
                    </HeaderedContentControl>
                    <HeaderedContentControl Header="Hızlı Adımlar" Style="{StaticResource RibbonGroup}" x:Name="QuickStepsRibbonGroup">
                        <StackPanel Orientation="Horizontal">
                            <StackPanel Orientation="Horizontal" x:Name="QuickStepsButtonPanel"/>
                            <Button Style="{StaticResource RibbonCmd}" Tag="&#xE713;" Click="OnManageQuickSteps" Content="Yönet…" ToolTip="Hızlı adımları düzenle"/>
                        </StackPanel>
                    </HeaderedContentControl>
                    <HeaderedContentControl Header="Ertele" Style="{StaticResource RibbonGroup}">
                        <Button Style="{StaticResource RibbonCmd}" Tag="&#xE823;" Click="OnSnoozeRibbonClick" Content="Ertele" ToolTip="Seçili maili ertele (okunmamış olarak geri döner)"/>
                    </HeaderedContentControl>
                    <HeaderedContentControl Header="Etiketler" Style="{StaticResource RibbonGroup}">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource RibbonCmd}" Tag="&#xE8C3;" Click="OnToggleRead" Content="Okundu / Okunmadı" ToolTip="Okundu (Ctrl+Q) · Okunmadı (Ctrl+U)"/>
                            <Button Style="{StaticResource RibbonCmd}" Tag="&#xE7C1;" Click="OnToggleFlag" Content="Bayrak"/>
                            <Button Style="{StaticResource RibbonCmd}" Tag="&#xE8DE;" Click="OnMoveMenu" Content="Taşı…"/>
                        </StackPanel>
                    </HeaderedContentControl>
                    <HeaderedContentControl Header="Takip" Style="{StaticResource RibbonGroup}">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource RibbonCmd}" Tag="&#xE762;" Click="OnMailToTask" Content="Görev Olarak Ekle" ToolTip="Seçili maili görev listesine ekle (Ctrl+Shift+K)"/>
                            <Button Style="{StaticResource RibbonCmd}" Tag="&#xE787;" Click="OnMailToMeeting" Content="Toplantı" ToolTip="Mailin kişileriyle toplantı ayarla"/>
                        </StackPanel>
                    </HeaderedContentControl>
                    <HeaderedContentControl Header="Gönder / Al" Style="{StaticResource RibbonGroup}">
                        <Button Style="{StaticResource RibbonCmd}" Tag="&#xE895;" Click="OnSyncAll" Content="Tüm Klasörleri Gönder/Al" ToolTip="F9"/>
                    </HeaderedContentControl>
                    <HeaderedContentControl Header="Bul" Style="{StaticResource RibbonGroup}">
                        <Button Style="{StaticResource RibbonCmd}" Tag="&#xE779;" Click="OnAddressBook" Content="Adres Defteri" ToolTip="Kişiler ve gruplar · Ctrl+Shift+B"/>
                    </HeaderedContentControl>
                    <HeaderedContentControl Header="Yapay Zeka" Style="{StaticResource RibbonGroup}">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource RibbonCmd}" Tag="&#xE8BD;" Click="OnAiSummarize" Content="Özetle"/>
                            <Button Style="{StaticResource RibbonCmd}" Tag="&#xE70F;" Click="OnAiDraftReply" Content="Cevap Yazdır"/>
                            <Button Style="{StaticResource RibbonCmd}" Tag="&#xE99A;" Click="OnToggleAiPane" Content="AI Paneli"/>
                            <Button Style="{StaticResource RibbonCmd}" Tag="&#xE945;" Click="OnSkills" Content="Skill'ler"/>
                        </StackPanel>
                    </HeaderedContentControl>
                </WrapPanel>

                <!-- SEND / RECEIVE -->
                <WrapPanel x:Name="RibbonSendRecv" Orientation="Horizontal" Visibility="Collapsed">
                    <HeaderedContentControl Header="Gönder ve Al" Style="{StaticResource RibbonGroup}">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource RibbonPrimaryCmd}" Tag="&#xE895;" Click="OnSyncAll" Content="Tüm Klasörleri Gönder/Al" ToolTip="F9"/>
                            <Button Style="{StaticResource RibbonCmd}" Tag="&#xE72C;" Click="OnSyncCurrent" Content="Klasörü Güncelleştir" ToolTip="F5"/>
                        </StackPanel>
                    </HeaderedContentControl>
                    <HeaderedContentControl Header="Durum" Style="{StaticResource RibbonGroup}">
                        <TextBlock x:Name="LastSyncText" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="6,6,6,0" Text="Henüz eşitlenmedi"/>
                    </HeaderedContentControl>
                </WrapPanel>

                <!-- FOLDER -->
                <WrapPanel x:Name="RibbonFolder" Orientation="Horizontal" Visibility="Collapsed">
                    <HeaderedContentControl Header="Hesaplar" Style="{StaticResource RibbonGroup}">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource RibbonPrimaryCmd}" Tag="&#xE8FA;" Click="OnAddAccount" Content="Hesap Ekle"/>
                            <Button Style="{StaticResource RibbonCmd}" Tag="&#xE713;" Click="OnEditAccount" Content="Hesap Ayarları"/>
                            <Button Style="{StaticResource RibbonCmd}" Tag="&#xE8BB;" Click="OnRemoveAccount" Content="Hesabı Kaldır"/>
                        </StackPanel>
                    </HeaderedContentControl>
                    <HeaderedContentControl Header="Temizle" Style="{StaticResource RibbonGroup}">
                        <Button Style="{StaticResource RibbonCmd}" Tag="&#xE8C3;" Click="OnMarkAllRead" Content="Tümünü Okundu Yap"/>
                    </HeaderedContentControl>
                </WrapPanel>

                <!-- VIEW -->
                <WrapPanel x:Name="RibbonView" Orientation="Horizontal" Visibility="Collapsed">
                    <HeaderedContentControl Header="Düzen" Style="{StaticResource RibbonGroup}">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource RibbonCmd}" Tag="&#xE89F;" Click="OnToggleFolderPane" Content="Klasör Bölmesi"/>
                            <Button Style="{StaticResource RibbonCmd}" Tag="&#xE8A1;" Click="OnToggleReadingPane" Content="Okuma Bölmesi"/>
                            <Button Style="{StaticResource RibbonCmd}" Tag="&#xE99A;" Click="OnToggleAiPane" Content="AI Paneli"/>
                        </StackPanel>
                    </HeaderedContentControl>
                    <HeaderedContentControl Header="Kurallar ve Biçim" Style="{StaticResource RibbonGroup}">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource RibbonCmd}" Tag="&#xE71E;" Click="OnRules" Content="Kurallar" ToolTip="Gelen iletiler için otomatik kurallar (taşı, bayrakla, görev yap). Yapay zekayla da oluşturulabilir."/>
                            <Button Style="{StaticResource RibbonCmd}" Tag="&#xE790;" Click="OnFormatRules" Content="Koşullu Biçimlendirme" ToolTip="Gönderen, konu, okunmamış, ek… koşullarına göre listede renk ve kalınlık. Yapay zekayla da oluşturulabilir."/>
                        </StackPanel>
                    </HeaderedContentControl>
                    <HeaderedContentControl Header="Tema" Style="{StaticResource RibbonGroup}">
                        <StackPanel Orientation="Horizontal" Margin="2,3,2,0">
                            <RadioButton x:Name="ThemeSystem" GroupName="theme" Style="{StaticResource SegmentRadio}" Content="Sistem" Tag="System" Checked="OnThemeChanged"/>
                            <RadioButton x:Name="ThemeLight" GroupName="theme" Style="{StaticResource SegmentRadio}" Content="Açık" Tag="Light" Checked="OnThemeChanged"/>
                            <RadioButton x:Name="ThemeDark" GroupName="theme" Style="{StaticResource SegmentRadio}" Content="Koyu" Tag="Dark" Checked="OnThemeChanged"/>
                        </StackPanel>
                    </HeaderedContentControl>
                    <HeaderedContentControl Header="Güvenlik ve görünüm" Style="{StaticResource RibbonGroup}">
                        <StackPanel Orientation="Horizontal" Margin="4,6,4,0">
                            <CheckBox x:Name="BlockImagesCheck" Content="Uzak resimleri engelle" Margin="0,0,14,0" Checked="OnBlockImagesChanged" Unchecked="OnBlockImagesChanged"/>
                            <CheckBox x:Name="ConversationCheck" Content="Konuşma olarak göster" Margin="0,0,14,0" Checked="OnConversationToggle" Unchecked="OnConversationToggle"/>
                            <CheckBox x:Name="AlertsCheck" Content="Masaüstü uyarısı" Checked="OnAlertsChanged" Unchecked="OnAlertsChanged"/>
                        </StackPanel>
                    </HeaderedContentControl>
                </WrapPanel>

                <!-- YAPAY ZEKA -->
                <WrapPanel x:Name="RibbonAi" Orientation="Horizontal" Visibility="Collapsed">
                    <HeaderedContentControl Header="Seçili E-posta" Style="{StaticResource RibbonGroup}">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource RibbonCmd}" Tag="&#xE8BD;" Click="OnAiSummarize" Content="Özetle"/>
                            <Button Style="{StaticResource RibbonCmd}" Tag="&#xE70F;" Click="OnAiDraftReply" Content="Cevap Yazdır"/>
                            <Button Style="{StaticResource RibbonCmd}" Tag="&#xE762;" Click="OnAiTasks" Content="Görevleri Çıkar"/>
                            <Button Style="{StaticResource RibbonCmd}" Tag="&#xE775;" Click="OnAiTranslate" Content="Türkçeye Çevir"/>
                        </StackPanel>
                    </HeaderedContentControl>
                    <HeaderedContentControl Header="Skill'ler ve ajanlar" Style="{StaticResource RibbonGroup}">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource RibbonCmd}" Tag="&#xE945;" Click="OnSkills" Content="Skill'ler" ToolTip="Teklif analizi, resim kontrolü, STEP hammadde, Excel güncelleme gibi kendi kurallarınız. Yeni mailde otomatik de çalışabilir."/>
                            <Button Style="{StaticResource RibbonCmd}" Tag="&#xE71B;" Click="OnAgents" Content="Ajanlara bağlan" ToolTip="Claude, Codex, Gemini, Cursor, VS Code ve diğer ajanlara tek tıkla MCP bağlantısı. Ajanlar mail gönderemez."/>
                        </StackPanel>
                    </HeaderedContentControl>
                    <HeaderedContentControl Header="Model" Style="{StaticResource RibbonGroup}">
                        <StackPanel Orientation="Horizontal" Margin="4,0,4,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,10,0">
                                <TextBlock Text="Aktif sağlayıcı:" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,5,0"/>
                                <TextBlock x:Name="RibbonProviderText" FontWeight="SemiBold"/>
                            </StackPanel>
                            <Button Style="{StaticResource RibbonCmd}" Tag="&#xE99A;" Click="OnToggleAiPane" Content="Paneli aç / kapat"/>
                        </StackPanel>
                    </HeaderedContentControl>
                </WrapPanel>
            </Grid>
        </Border>

        <!-- ================= MAIN CONTENT ================= -->
        <Grid Grid.Row="2" x:Name="MainGrid" SizeChanged="OnMainGridSizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ColFolders" Width="230" MinWidth="0"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition x:Name="ColList" Width="380" MinWidth="260"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition x:Name="ColReading" Width="*" MinWidth="0"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition x:Name="ColAi" Width="340" MinWidth="0"/>
            </Grid.ColumnDefinitions>

            <!-- FOLDER PANE -->
            <Grid Background="{DynamicResource BgSurfaceSecondaryBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ContentControl x:Name="PimSide" Visibility="Collapsed" Panel.ZIndex="5" Background="{DynamicResource BgSurfaceSecondaryBrush}"/>
                <TreeView x:Name="FolderTree" BorderThickness="0" Padding="4,8,0,0" Background="Transparent" SelectedItemChanged="OnFolderSelected"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.ContextMenu>
                        <ContextMenu Opened="OnFolderTreeContextMenuOpened">
                            <MenuItem Header="Yeni Arama Klasörü..." Icon="&#xE721;" Click="OnNewSearchFolderClick"/>
                            <MenuItem Header="Arama Klasörünü Düzenle..." x:Name="EditSearchFolderMenuItem" Click="OnEditSearchFolderClick"/>
                            <MenuItem Header="Arama Klasörünü Sil" x:Name="DeleteSearchFolderMenuItem" Click="OnDeleteSearchFolderClick"/>
                        </ContextMenu>
                    </TreeView.ContextMenu>
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate DataType="{x:Type m:FolderNode}" ItemsSource="{Binding Children}">
                            <Grid Margin="0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Margin="0,1,8,0" VerticalAlignment="Center">
                                    <Border Width="8" Height="8" CornerRadius="4" Background="{Binding CustomColor, Converter={x:Static local:HexBrush.Instance}}"
                                            Margin="0,0,6,0" VerticalAlignment="Center" Visibility="{Binding HasCustomColor, Converter={StaticResource BoolVis}}"/>
                                    <TextBlock Text="{Binding Icon}" FontFamily="{StaticResource Icons}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" x:Name="nm" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <Border Grid.Column="2" x:Name="cnt" Background="{DynamicResource AccentFillBrush}" CornerRadius="8" Padding="6,0" MinWidth="20" Margin="8,0,6,0" VerticalAlignment="Center" Visibility="Collapsed">
                                    <TextBlock Text="{Binding UnreadText}" Foreground="{DynamicResource TextOnAccentBrush}" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center"/>
                                </Border>
                            </Grid>
                            <HierarchicalDataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsAccountRoot}" Value="True">
                                    <Setter TargetName="nm" Property="FontWeight" Value="SemiBold"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsSearchFolderRoot}" Value="True">
                                    <Setter TargetName="nm" Property="FontWeight" Value="SemiBold"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsUnifiedInbox}" Value="True">
                                    <Setter TargetName="nm" Property="FontWeight" Value="SemiBold"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding UnreadText, Converter={x:Static local:AttachmentIcon.NotEmpty}}" Value="True">
                                    <Setter TargetName="cnt" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="nm" Property="FontWeight" Value="SemiBold"/>
                                </DataTrigger>
                            </HierarchicalDataTemplate.Triggers>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
                <TextBlock x:Name="NoAccountHint" Margin="14,20,14,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Visibility="Collapsed">
                    <Run x:Name="NoAccountRun" Text="Henüz hesap yok."/> <Hyperlink Click="OnAddAccount"><Run x:Name="AddAccountRun" Text="Hesap ekle"/></Hyperlink>
                </TextBlock>
                <!-- Bottom navigation (Mail / Calendar / Contacts / Tasks) -->
                <Border Grid.Row="1" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="6,4">
                    <UniformGrid Rows="1">
                        <Button Style="{StaticResource NavIcon}" x:Name="NavMail" Content="&#xE715;" Foreground="{DynamicResource AccentPrimaryBrush}" ToolTip="Posta (Ctrl+1)" Click="OnNavMail"/>
                        <Button Style="{StaticResource NavIcon}" x:Name="NavCalendar" Content="&#xE787;" ToolTip="Takvim (Ctrl+2)" Click="OnNavCalendar"/>
                        <Button Style="{StaticResource NavIcon}" x:Name="NavPeople" Content="&#xE77B;" ToolTip="Kişiler (Ctrl+3)" Tag="Kişiler" Click="OnNavSoon"/>
                        <Button Style="{StaticResource NavIcon}" x:Name="NavTasks" Content="&#xE762;" ToolTip="Görevler (Ctrl+4)" Click="OnNavTasks"/>
                        <Button Style="{StaticResource NavIcon}" x:Name="NavQuotes" Content="&#xE8A1;" ToolTip="Teklif Masası (Ctrl+5)" Click="OnNavQuotes"/>
                    </UniformGrid>
                </Border>
            </Grid>
            <GridSplitter Grid.Column="1" x:Name="SplitFolders" ResizeBehavior="PreviousAndNext"/>

            <!-- MESSAGE LIST -->
            <Grid Grid.Column="2" Background="{DynamicResource BgSurfacePrimaryBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Margin="10,10,10,4">
                    <TextBox x:Name="SearchBox" Padding="28,3,8,3" KeyDown="OnSearchKey" ToolTip="Geçerli posta kutusunda ara (Enter) · Ctrl+E"/>
                    <TextBlock Text="&#xE721;" FontFamily="{StaticResource Icons}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{DynamicResource TextMutedBrush}" IsHitTestVisible="False"/>
                    <TextBlock x:Name="SearchPlaceholder" Text="Geçerli Posta Kutusunda Ara" Foreground="{DynamicResource TextMutedBrush}" Margin="30,0,0,0"
                               VerticalAlignment="Center" IsHitTestVisible="False"/>
                </Grid>
                <DockPanel Grid.Row="1" Margin="10,2,10,4">
                    <TextBlock x:Name="ListSortText" DockPanel.Dock="Right" Text="Tarihe göre ↓" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="FilterAll" Style="{StaticResource FilterTab}" IsChecked="True" Checked="OnFilterChanged">Tümü</RadioButton>
                        <RadioButton x:Name="FilterUnread" Style="{StaticResource FilterTab}" Checked="OnFilterChanged">Okunmamış</RadioButton>
                        <RadioButton x:Name="FilterFlagged" Style="{StaticResource FilterTab}" Checked="OnFilterChanged">Bayraklı</RadioButton>
                        <RadioButton x:Name="FilterSnoozed" Style="{StaticResource FilterTab}" Checked="OnFilterChanged">Ertelenen</RadioButton>
                        <RadioButton x:Name="FilterNewsletters" Style="{StaticResource FilterTab}" Checked="OnFilterChanged">Bültenler</RadioButton>
                    </StackPanel>
                </DockPanel>
                <ListView Grid.Row="2" x:Name="MessageList" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource BorderSubtleBrush}" Background="Transparent"
                          ItemsSource="{Binding Source={StaticResource MailView}}" SelectionMode="Extended"
                          SelectionChanged="OnMessageSelected" MouseDoubleClick="OnMessageDoubleClick" KeyDown="OnListKey"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                          VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListView.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Yanıtla" Icon="&#xE97A;" InputGestureText="Ctrl+R" Click="OnReply"/>
                            <MenuItem Header="Tümünü Yanıtla" Icon="&#xE8C2;" InputGestureText="Ctrl+Shift+R" Click="OnReplyAll"/>
                            <MenuItem Header="İlet" Icon="&#xE72D;" InputGestureText="Ctrl+F" Click="OnForward"/>
                            <MenuItem Header="Ayrı pencerede aç" Icon="&#xE8A7;" InputGestureText="Enter" Click="OnOpenInWindow"/>
                            <Separator/>
                            <MenuItem Header="Okunmadı / Okundu olarak işaretle" Icon="&#xE8C3;" InputGestureText="Ctrl+Q / Ctrl+U" Click="OnToggleRead"/>
                            <MenuItem Header="İzleme bayrağı" Icon="&#xE7C1;" Click="OnToggleFlag"/>
                            <MenuItem Header="Ertele" Icon="&#xE823;" x:Name="SnoozeContextMenu" SubmenuOpened="OnSnoozeSubmenuOpened">
                                <MenuItem Header="Bugün akşam (18:00)" Click="OnSnoozeThisEvening"/>
                                <MenuItem Header="Yarın sabah (09:00)" Click="OnSnoozeTomorrowMorning"/>
                                <MenuItem Header="Gelecek hafta (Pazartesi 09:00)" Click="OnSnoozeNextWeek"/>
                                <Separator/>
                                <MenuItem Header="Tarih ve saat seç…" Click="OnSnoozeCustomDate"/>
                                <MenuItem Header="Ertelemeyi Kaldır" x:Name="UnsnoozeContextMenuItem" Click="OnUnsnooze" Visibility="Collapsed"/>
                            </MenuItem>
                            <MenuItem Header="Taşı…" Icon="&#xE8DE;" Click="OnMoveMenu"/>
                            <MenuItem Header="Görev olarak ekle" Icon="&#xE762;" InputGestureText="Ctrl+Shift+K" Click="OnMailToTask"/>
                            <MenuItem Header="Toplantı ayarla" Icon="&#xE787;" Click="OnMailToMeeting"/>
                            <MenuItem Header="Bunun gibi mailler için kural oluştur…" Icon="&#xE71E;" Click="OnCreateRuleFromMail"/>
                            <MenuItem Header="Bu göndereni her zaman Bültenler klasörüne taşı" Icon="&#xE8DE;" Click="OnAlwaysMoveToNewslettersClick"/>
                            <MenuItem Header="Teklif masasına ekle" Icon="&#xE8A1;" Click="OnMailAddToQuoteDesk"/>
                            <MenuItem Header="Hızlı Adımlar" Icon="&#xE715;" x:Name="QuickStepsContextMenu" SubmenuOpened="OnQuickStepsSubmenuOpened"/>
                            <Separator/>
                            <MenuItem Header="AI ile özetle" Icon="&#xE8BD;" Click="OnAiSummarize"/>
                            <MenuItem Header="AI ile cevap yazdır" Icon="&#xE70F;" Click="OnAiDraftReply"/>
                            <Separator/>
                            <MenuItem Header="Arşivle" Icon="&#xE7B8;" Click="OnArchive"/>
                            <MenuItem Header="Sil" Icon="&#xE74D;" InputGestureText="Delete" Style="{StaticResource DangerMenuItem}" Click="OnDelete"/>
                        </ContextMenu>
                    </ListView.ContextMenu>
                    <ListView.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource BgSurfaceSecondaryBrush}" Padding="12,4" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </Border>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListView.GroupStyle>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <Border x:Name="bd" Background="Transparent" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1" SnapsToDevicePixels="True">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource BgListHoverBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentSubtleBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate DataType="{x:Type m:MailHeader}">
                            <Grid Background="{Binding FormatBack, Converter={x:Static local:HexBrush.Instance}, ConverterParameter=back}" ToolTip="{Binding FormatRuleName}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Rectangle x:Name="unreadBar" Fill="{DynamicResource UnreadBarBrush}" Visibility="Hidden"/>
                                <Border Grid.Column="1" Background="Transparent" Cursor="Hand" ToolTip="{local:Tr 'Konuşmayı aç / kapat'}"
                                        MouseLeftButtonUp="OnThreadToggle" Visibility="{Binding IsThreadHead, Converter={StaticResource BoolVis}}">
                                    <TextBlock Text="{Binding ThreadArrow}" FontFamily="{StaticResource Icons}" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Top" Margin="2,12,0,0"/>
                                </Border>
                                <StackPanel Grid.Column="2" x:Name="body" Margin="2,7,4,8">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="from" Text="{Binding FromDisplay}" FontSize="13.5" TextTrimming="CharacterEllipsis" MaxWidth="210"/>
                                        <TextBlock Text="{Binding ThreadCountText}" Foreground="{DynamicResource AccentPrimaryBrush}" FontSize="12" Margin="6,1,0,0"/>
                                        <Border Background="{Binding AccountColor, Converter={x:Static local:HexBrush.Instance}}"
                                                CornerRadius="3" Padding="4,1" Margin="6,1,0,0" VerticalAlignment="Center"
                                                Visibility="{Binding ShowAccountBadge, Converter={StaticResource BoolVis}}">
                                            <TextBlock Text="{Binding AccountName}" FontSize="10" Foreground="White" FontWeight="SemiBold"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock x:Name="subj" Text="{Binding SubjectDisplay}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                                    <TextBlock x:Name="prev" Text="{Binding Preview}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="3" Margin="0,7,10,0" HorizontalAlignment="Right">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock Text="&#xE723;" FontFamily="{StaticResource Icons}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,2,6,0"
                                                   Visibility="{Binding HasAttachments, Converter={StaticResource BoolVis}}"/>
                                        <TextBlock x:Name="date" Text="{Binding DateDisplay}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                                    </StackPanel>
                                    <TextBlock Text="&#xE7C1;" FontFamily="{StaticResource Icons}" Foreground="{DynamicResource FlagBrush}" HorizontalAlignment="Right" Margin="0,8,0,0"
                                               Visibility="{Binding IsFlagged, Converter={StaticResource BoolVis}}"/>
                                </StackPanel>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsThreadChild}" Value="True">
                                    <Setter TargetName="body" Property="Margin" Value="18,5,4,6"/>
                                    <Setter TargetName="subj" Property="Visibility" Value="Collapsed"/>
                                    <Setter TargetName="from" Property="FontSize" Value="12.5"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsRead}" Value="False">
                                    <Setter TargetName="unreadBar" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="from" Property="FontWeight" Value="SemiBold"/>
                                    <Setter TargetName="subj" Property="Foreground" Value="{DynamicResource AccentPrimaryBrush}"/>
                                    <Setter TargetName="subj" Property="FontWeight" Value="SemiBold"/>
                                    <Setter TargetName="date" Property="Foreground" Value="{DynamicResource AccentPrimaryBrush}"/>
                                    <Setter TargetName="date" Property="FontWeight" Value="SemiBold"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasFormatFore}" Value="True">
                                    <Setter TargetName="from" Property="Foreground" Value="{Binding FormatFore, Converter={x:Static local:HexBrush.Instance}}"/>
                                    <Setter TargetName="subj" Property="Foreground" Value="{Binding FormatFore, Converter={x:Static local:HexBrush.Instance}}"/>
                                    <Setter TargetName="date" Property="Foreground" Value="{Binding FormatFore, Converter={x:Static local:HexBrush.Instance}}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding FormatBold}" Value="True">
                                    <Setter TargetName="from" Property="FontWeight" Value="Bold"/>
                                    <Setter TargetName="subj" Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding FormatItalic}" Value="True">
                                    <Setter TargetName="from" Property="FontStyle" Value="Italic"/>
                                    <Setter TargetName="subj" Property="FontStyle" Value="Italic"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock Grid.Row="2" x:Name="EmptyListText" Text="Bu görünümde gösterilecek bir öğe yok." Foreground="{DynamicResource TextMutedBrush}"
                           HorizontalAlignment="Center" Margin="0,40,0,0" Visibility="Collapsed"/>
                <Border Grid.Row="3" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="10,6" Background="{DynamicResource BgSurfaceSecondaryBrush}">
                    <TextBlock x:Name="OlderLinkText" TextWrapping="Wrap" FontSize="12" HorizontalAlignment="Center">
                        <Hyperlink Click="OnLoadOlder">Sunucudaki daha eski iletileri göster</Hyperlink>
                    </TextBlock>
                </Border>
            </Grid>
            <GridSplitter Grid.Column="3" x:Name="SplitList" ResizeBehavior="PreviousAndNext"/>

            <!-- READING PANE -->
            <Grid Grid.Column="4" Background="{DynamicResource BgSurfacePrimaryBrush}" x:Name="ReadingPane">
                <StackPanel x:Name="ReadingEmpty" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="&#xE715;" FontFamily="{StaticResource Icons}" FontSize="44" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Okumak için bir öğe seçin" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13.5" Margin="0,12,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
                <Grid x:Name="ReadingContent" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Margin="18,10,18,4">
                        <DockPanel Margin="0,0,0,10">
                            <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Margin="4,0,0,0" Click="OnOpenInWindow" ToolTip="İletiyi ayrı pencerede aç">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8A7;" FontFamily="{StaticResource Icons}" Margin="0,1,6,0"/><TextBlock Text="Ayrı pencere"/></StackPanel>
                            </Button>
                            <WrapPanel>
                                <Button Style="{StaticResource FlatButton}" Click="OnReply"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE97A;" FontFamily="{StaticResource Icons}" Margin="0,1,6,0" Foreground="{DynamicResource IconBrush}"/><TextBlock Text="Yanıtla"/></StackPanel></Button>
                                <Button Style="{StaticResource FlatButton}" Click="OnReplyAll"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8C2;" FontFamily="{StaticResource Icons}" Margin="0,1,6,0" Foreground="{DynamicResource IconBrush}"/><TextBlock Text="Tümünü Yanıtla"/></StackPanel></Button>
                                <Button Style="{StaticResource FlatButton}" Click="OnForward"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72D;" FontFamily="{StaticResource Icons}" Margin="0,1,6,0" Foreground="{DynamicResource IconBrush}"/><TextBlock Text="İlet"/></StackPanel></Button>
                                <Button Style="{StaticResource FlatButton}" Click="OnAiSummarize"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE99A;" FontFamily="{StaticResource Icons}" Margin="0,1,6,0" Foreground="{DynamicResource IconBrush}"/><TextBlock Text="AI Özet"/></StackPanel></Button>
                            </WrapPanel>
                        </DockPanel>
                        <TextBlock x:Name="SubjectText" FontSize="18" FontWeight="SemiBold" FontFamily="{StaticResource FontDisplay}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <Border x:Name="RemoteImagesBar" Visibility="Collapsed" Background="{DynamicResource StatusWarningBgBrush}" BorderBrush="{DynamicResource StatusWarningBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,8">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Resimleri yükle" Click="OnLoadRemoteImages" Style="{StaticResource FlatButton}" Margin="8,0,0,0"/>
                                <TextBlock Text="Bu maildeki internet resimleri engellendi." VerticalAlignment="Center" Foreground="{DynamicResource StatusWarningBrush}" TextWrapping="Wrap"/>
                            </DockPanel>
                        </Border>
                        <Border x:Name="InviteBar" Visibility="Collapsed" Background="{DynamicResource AccentSubtleBrush}" BorderBrush="{DynamicResource AccentSubtleBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,8"/>
                        <Border x:Name="UnsubscribeBar" Visibility="Collapsed" Background="{DynamicResource BgSurfaceSecondaryBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,8">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0">
                                    <Button x:Name="UnsubscribeButton" Content="Abonelikten çık" Click="OnUnsubscribeClick" Style="{StaticResource FlatButton}" Margin="0,0,6,0"/>
                                    <Button x:Name="MoveToNewslettersButton" Content="Her zaman Bültenler'e taşı" Click="OnAlwaysMoveToNewslettersClick" Style="{StaticResource FlatButton}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE715;" FontFamily="{StaticResource Icons}" Margin="0,1,6,0" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="UnsubscribeBarText" Text="Bu ileti bir bülten veya toplu listedir." Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="40" Height="40" CornerRadius="20" x:Name="AvatarBorder" Background="#5C2D91" VerticalAlignment="Top">
                                <TextBlock x:Name="AvatarText" Foreground="White" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                <TextBlock x:Name="FromText" Visibility="Collapsed"/>
                                <TextBlock x:Name="ToText" Visibility="Collapsed"/>
                                <TextBlock x:Name="CcText" Visibility="Collapsed"/>
                                <StackPanel x:Name="FromPanel"/>
                                <StackPanel x:Name="ToPanel" Margin="0,2,0,0"/>
                                <StackPanel x:Name="CcPanel" Margin="0,1,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" x:Name="DateText" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="10,0,0,0"/>
                        </Grid>
                    </StackPanel>
                    <ItemsControl Grid.Row="1" x:Name="AttachmentList" Margin="70,4,18,4">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type m:AttachmentInfo}">
                                <Button Style="{StaticResource ChipButton}" Click="OnAttachmentClick" Tag="{Binding}" ToolTip="{local:Tr 'Açmak için tıkla (STEP/PDF/resim MailStudio içinde açılır) · sağ tık: kaydet'}">
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="{local:Tr 'MailStudio içinde aç / ölç'}" Icon="&#xE7B3;" Click="OnAttachmentMenuOpen"/>
                                            <MenuItem Header="{local:Tr 'Önceki revizyonla karşılaştır...'}" Icon="&#xE8AB;" Click="OnAttachmentCompareRevision"/>
                                            <MenuItem Header="{local:Tr 'Farklı kaydet...'}" Icon="&#xE792;" Click="OnAttachmentSaveAs"/>
                                            <MenuItem Header="{local:Tr 'Tüm ekleri kaydet...'}" Icon="&#xE8B7;" Click="OnSaveAllAttachments"/>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding FileName, Converter={x:Static local:AttachmentIcon.Glyph}}" FontFamily="{StaticResource Icons}" Margin="0,1,7,0" Foreground="{Binding FileName, Converter={x:Static local:AttachmentIcon.Brush}}"/>
                                        <TextBlock Text="{Binding FileName}" MaxWidth="220" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding SizeDisplay}" Foreground="{DynamicResource TextMutedBrush}" Margin="6,0,0,0" FontSize="12"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Grid.Row="2" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Margin="18,2,8,0">
                        <wv2:WebView2 x:Name="MailWeb" DefaultBackgroundColor="White"/>
                    </Border>
                </Grid>
                <ContentControl x:Name="InlineComposeHost" Visibility="Collapsed"/>
                <Border x:Name="LoadingOverlay" Background="{DynamicResource BgOverlayBrush}" Visibility="Collapsed">
                    <TextBlock Text="Yükleniyor..." HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </Border>
            </Grid>
            <GridSplitter Grid.Column="5" x:Name="SplitAi" ResizeBehavior="PreviousAndNext"/>

            <!-- AI PANE -->
            <Grid Grid.Column="6" x:Name="AiPane" Background="{DynamicResource BgSurfaceSecondaryBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <!-- header -->
                <Border BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="12,7">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" Click="OnToggleAiPane" ToolTip="Kapat"/>
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE710;" Click="OnAiClear" ToolTip="Yeni sohbet"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE99A;" FontFamily="{StaticResource Icons}" FontSize="15" Foreground="{DynamicResource IconBrush}" Margin="0,1,8,0"/>
                            <TextBlock Text="Yapay Zeka Asistanı" FontSize="14" FontWeight="SemiBold"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <!-- provider/model -->
                <StackPanel Grid.Row="1" Margin="12,10,12,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Sağlayıcı" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,3"/>
                            <ComboBox x:Name="ProviderBox" SelectionChanged="OnProviderChanged"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Model" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,3"/>
                            <ComboBox x:Name="ModelBox" IsEditable="True" LostFocus="OnModelChanged" SelectionChanged="OnModelSelectionChanged"/>
                        </StackPanel>
                    </Grid>
                    <DockPanel Margin="0,6,0,0">
                        <Button x:Name="LoginButton" DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Margin="6,0,0,0" Padding="8,2" MinHeight="26"
                                FontSize="12" Click="OnProviderLogin" Content="Oturum aç" ToolTip="Bu sağlayıcıya tarayıcıdan giriş yap"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="ProviderDot" Width="8" Height="8" Fill="{DynamicResource StatusSuccessBrush}" Margin="0,1,6,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ProviderBadge" Foreground="{DynamicResource StatusSuccessBrush}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="230"/>
                        </StackPanel>
                    </DockPanel>
                    <CheckBox x:Name="IncludeMailCheck" IsChecked="True" Margin="0,10,0,4">
                        <TextBlock x:Name="IncludeMailText" Text="Açık e-postayı bağlam olarak gönder" TextTrimming="CharacterEllipsis"/>
                    </CheckBox>
                    <CheckBox x:Name="MailboxAccessCheck" Margin="0,0,0,4" Checked="OnMailboxAccessChanged" Unchecked="OnMailboxAccessChanged"
                              ToolTip="Claude / Codex / Gemini, MCP üzerinden posta kutunda arama yapabilir, mailleri okuyabilir ve taslak oluşturabilir. Göndermez.">
                        <TextBlock Text="Posta kutusuna erişim (MCP: ara, oku, taslak)"/>
                    </CheckBox>
                    <WrapPanel x:Name="QuickActions" Margin="0,4,0,0"/>
                        <WrapPanel x:Name="SkillActions" Margin="0,2,0,0"/>
                </StackPanel>
                <!-- sohbet -->
                <ScrollViewer Grid.Row="2" x:Name="ChatScroll" VerticalScrollBarVisibility="Auto" Padding="12,4,12,4">
                    <ItemsControl x:Name="ChatList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:ChatMessage}">
                                <Border x:Name="bub" Margin="0,4,28,4" Padding="10,7" CornerRadius="4" Background="{DynamicResource BgSurfacePrimaryBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" HorizontalAlignment="Left">
                                    <StackPanel>
                                        <TextBlock x:Name="who" Text="{Binding Author}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,3"/>
                                        <TextBox Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource PlainTextBox}" TextWrapping="Wrap" FontSize="12.5"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0" Visibility="{Binding ShowActions, Converter={StaticResource BoolVis}}">
                                            <Button Style="{StaticResource FlatButton}" Padding="7,1" MinHeight="24" FontSize="12" Click="OnChatCopy" Tag="{Binding}" Content="{x:Static local:ChatMessage.CopyLabel}"/>
                                            <Button Style="{StaticResource FlatButton}" Padding="7,1" MinHeight="24" FontSize="12" Click="OnChatUseAsReply" Tag="{Binding}" Content="{x:Static local:ChatMessage.UseAsReplyLabel}"/>
                                            <Button Style="{StaticResource FlatButton}" Padding="7,1" MinHeight="24" FontSize="12" Click="OnChatToTasks" Tag="{Binding}" Content="{x:Static local:ChatMessage.ToTasksLabel}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsUser}" Value="True">
                                        <Setter TargetName="bub" Property="Background" Value="{DynamicResource ChatUserBubbleBrush}"/>
                                        <Setter TargetName="bub" Property="BorderBrush" Value="{DynamicResource ChatUserBorderBrush}"/>
                                        <Setter TargetName="bub" Property="HorizontalAlignment" Value="Right"/>
                                        <Setter TargetName="bub" Property="Margin" Value="28,4,0,4"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsError}" Value="True">
                                        <Setter TargetName="bub" Property="Background" Value="{DynamicResource StatusDangerBgBrush}"/>
                                        <Setter TargetName="bub" Property="BorderBrush" Value="{DynamicResource StatusDangerBorderBrush}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <!-- input -->
                <Border Grid.Row="3" Background="{DynamicResource BgSurfaceSecondaryBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="10,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBox x:Name="AiInput" MinHeight="54" MaxHeight="160" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                 VerticalContentAlignment="Top" PreviewKeyDown="OnAiInputKey"/>
                        <TextBlock x:Name="AiPlaceholder" Text="Bir şey sorun... (Enter: gönder, Shift+Enter: yeni satır)" Foreground="{DynamicResource TextMutedBrush}" Margin="9,6,0,0" IsHitTestVisible="False"/>
                        <DockPanel Grid.Row="1" Margin="0,6,0,0">
                            <Button DockPanel.Dock="Right" x:Name="AiSendButton" Style="{StaticResource PrimaryButton}" Margin="0" Click="OnAiSend" Padding="14,3">Gönder</Button>
                            <Button DockPanel.Dock="Right" x:Name="AiStopButton" Style="{StaticResource FlatButton}" Margin="0,0,6,0" Click="OnAiStop" Visibility="Collapsed">Durdur</Button>
                            <TextBlock x:Name="AiStatus" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- CALENDAR / TASKS (Outlook modules) -->
            <ContentControl Grid.Column="2" Grid.ColumnSpan="5" x:Name="PimHost" Visibility="Collapsed" Panel.ZIndex="20" Focusable="False"/>
        </Grid>

        <!-- ================= UNDO SEND NOTIFICATION BAR ================= -->
        <Border Grid.Row="3" x:Name="UndoSendBar" Background="{DynamicResource AccentSubtleBrush}" BorderBrush="{DynamicResource AccentPrimaryBrush}" BorderThickness="0,1,0,1" MinHeight="36" Padding="14,4" Visibility="Collapsed">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE724;" FontFamily="{StaticResource Icons}" FontSize="15" Foreground="{DynamicResource AccentPrimaryBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="UndoSendText" Text="İleti 10 sn içinde gönderilecek..." FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <Button x:Name="UndoSendButton" Content="Geri Al" Click="OnUndoSendClick" Style="{StaticResource PrimaryButton}" Padding="12,2" Margin="0,0,8,0" FontWeight="SemiBold"/>
                    <Button x:Name="SendNowButton" Content="Şimdi Gönder" Click="OnSendNowClick" Style="{StaticResource FlatButton}" Padding="8,2"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ================= STATUS BAR ================= -->
        <Border Grid.Row="4" Background="{DynamicResource AccentHeaderBrush}" MinHeight="24">
            <DockPanel Margin="10,0">
                <TextBlock x:Name="ConnText" DockPanel.Dock="Right" Foreground="{DynamicResource TextOnAccentBrush}" FontSize="12" VerticalAlignment="Center" Text="Bağlı değil"/>
                <TextBlock x:Name="OfflineText" DockPanel.Dock="Right" Foreground="{DynamicResource TextOnAccentBrush}" FontSize="12" Opacity="0.9" VerticalAlignment="Center" Margin="0,0,24,0"
                           ToolTip="Outlook gibi: maillerin yazıları ve ekleri bilgisayarda tutulur, internet olmadan da açılır."/>
                <TextBlock x:Name="CountText" Foreground="{DynamicResource TextOnAccentBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,24,0"/>
                <TextBlock x:Name="StatusText" Foreground="{DynamicResource TextOnAccentBrush}" FontSize="12" VerticalAlignment="Center" Opacity="0.95" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
